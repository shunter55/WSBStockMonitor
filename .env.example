# --- Reddit (no API key required by default) ---
REDDIT_AUTH_MODE=auto
REDDIT_USER_AGENT=wsbstockmonitor:1.0 (by /u/your_reddit_username)
REDDIT_SUBREDDIT=wallstreetbets
REDDIT_MAX_POSTS=800
REDDIT_MAX_COMMENTS_PER_POST=0
REDDIT_REQUEST_DELAY_SEC=2.0

# --- Gemini API (optional) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_GROUNDING=false

# --- Shared ---
WSB_WINDOW_HOURS=48
WSB_OUTPUT_DIR=data/reports

# --- Vercel (scheduled report + cached page) ---
# Create a Blob store in Vercel → Storage → Connect to project
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
# Vercel Cron auth (you create this value; see README)
CRON_SECRET=your_random_secret
# On Vercel: gemini_only (default), both, or reddit_only — Reddit public API is blocked on Vercel IPs
CRON_MODE=gemini_only
