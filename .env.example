# --- Reddit (no API key required by default) ---
# Uses public .json endpoints when client id/secret are not set.
REDDIT_AUTH_MODE=auto
# auto | public | oauth
REDDIT_USER_AGENT=wsbstockmonitor:1.0 (by /u/your_reddit_username)

REDDIT_SUBREDDIT=wallstreetbets
REDDIT_MAX_POSTS=800
REDDIT_MAX_COMMENTS_PER_POST=0
REDDIT_REQUEST_DELAY_SEC=2.0

# Optional OAuth (only if Reddit approved your app):
# REDDIT_CLIENT_ID=your_client_id
# REDDIT_CLIENT_SECRET=your_client_secret

# --- Gemini API (optional) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_GROUNDING=false

# --- Shared ---
WSB_WINDOW_HOURS=48
WSB_OUTPUT_DIR=data/reports
